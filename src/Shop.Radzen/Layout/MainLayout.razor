@inherits LayoutComponentBase
@inject DiagnosticsService Diag

@* Каркас Radzen: RadzenHeader, RadzenSidebar и RadzenBody - прямые дети RadzenLayout.
   Компонента RadzenMain в Radzen нет: такой тег рисовался пустым HTML-элементом. *@
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" Style="padding:0 16px 0 0;min-height:48px">
            <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" Style="margin:0;color:inherit" Text="Мини-Магазин" />
            <span style="flex:1"></span>
            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" IsPill="true" Text="Radzen · Material" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="_sidebarExpanded">
        @* Ссылки БЕЗ ведущего слеша: с ним браузер считает их от корня сайта, и на GitHub Pages
           переход уводит на /diagnostics вместо /BlazorBenchmark/radzen/diagnostics. Относительные
           ссылки разрешаются от <base href> и работают и в корне, и в подкаталоге. *@
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Обзор" Icon="dashboard" Path="./" Match="NavLinkMatch.All" />
            <RadzenPanelMenuItem Text="Товары" Icon="inventory_2" Path="products" />
            <RadzenPanelMenuItem Text="Заказы" Icon="shopping_cart" Path="orders" />
            <RadzenPanelMenuItem Text="Оплаты" Icon="receipt_long" Path="payments" />
            <RadzenPanelMenuItem Text="Клиенты" Icon="people" Path="customers" />
            <RadzenPanelMenuItem Text="Компоненты" Icon="widgets" Path="components" />
            <RadzenPanelMenuItem Text="Диагностика" Icon="speed" Path="diagnostics" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody Style="padding:24px">
        @Body
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

@code {
    private bool _sidebarExpanded = true;

    // Отмечаем момент, когда интерфейс приложения впервые готов: это главный показатель
    // сравнения библиотек на странице «Диагностика».
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Diag.MarkAppReadyAsync();
    }
}
