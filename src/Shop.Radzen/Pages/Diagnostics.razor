@page "/diagnostics"
@inject DiagnosticsService Diag
@inject NotificationService Notify

<PageTitle>Диагностика — Radzen</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Style="margin-bottom:16px">
    <RadzenHeading Size="H5" Style="margin:0" Text="Диагностика" />
    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
        <RadzenButton Text="Скопировать отчёт" Icon="content_copy" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                      Disabled="@(_report is null)" Click="@(CopyAsync)" />
        <RadzenButton Text="Собрать метрики" Icon="refresh" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                      Click="@(CollectAsync)" />
    </RadzenStack>
</RadzenStack>

<RadzenLabel Text="Метрики нагрузки приложения: тайминги загрузки и отрисовки, состав и вес ресурсов (рантайм .NET, пакет UI-библиотеки, шрифты), размер DOM и CSS, JS-куча, параметры устройства. Страница и скрипт идентичны во всех трёх приложениях бенчмарка — снимайте показатели после полной загрузки и обхода страниц."
             Style="color:var(--rz-text-secondary-color);font-size:.875rem;margin-bottom:16px;display:block" />

@if (_report is null)
{
    <RadzenLabel Text="Нажмите «Собрать метрики»…" />
}
else
{
    @foreach (var section in _report.ToSections())
    {
        <RadzenCard Style="margin-bottom:16px;padding:0">
            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin:16px 16px 8px">@section.Title</RadzenText>
            <RadzenDataGrid TItem="DiagnosticsRow" Data="@section.Rows" Density="Density.Compact" AllowPaging="false"
                            AllowSorting="false" AllowFiltering="false" Style="width:100%">
                <Columns>
                    <RadzenDataGridColumn TItem="DiagnosticsRow" Property="Name" Title="Показатель" Width="320px" />
                    <RadzenDataGridColumn TItem="DiagnosticsRow" Property="Value" Title="Значение" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }

    <RadzenCard Style="padding:0">
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin:16px 16px 8px">Ресурсы по группам</RadzenText>
        <RadzenDataGrid TItem="ResourceGroupInfo" Data="@_report.ResourceGroups" Density="Density.Compact" AllowPaging="false"
                        AllowSorting="false" AllowFiltering="false" Style="width:100%">
            <Columns>
                <RadzenDataGridColumn TItem="ResourceGroupInfo" Property="Name" Title="Группа" Width="320px" />
                <RadzenDataGridColumn TItem="ResourceGroupInfo" Property="Count" Title="Файлов" Width="100px" />
                <RadzenDataGridColumn TItem="ResourceGroupInfo" Title="По сети">
                    <Template Context="group">@DiagnosticsReport.Bytes(group.TransferBytes)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ResourceGroupInfo" Title="Распаковано">
                    <Template Context="group">@DiagnosticsReport.Bytes(group.DecodedBytes)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ResourceGroupInfo" Property="CachedCount" Title="Из кэша" Width="100px" />
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private DiagnosticsReport? _report;

    private async Task CollectAsync() => _report = await Diag.CollectAsync("Radzen");

    private async Task CopyAsync()
    {
        if (_report is null) return;
        var copied = await Diag.CopyAsync(_report.ToPlainText());
        if (copied)
            Notify.Notify(NotificationSeverity.Success, "Готово", "Отчёт скопирован");
        else
            Notify.Notify(NotificationSeverity.Warning, "Отказ", "Браузер не дал доступ к буферу обмена");
    }
}
