@namespace Bench.MudBlazor
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<MudThemeProvider /><MudPopoverProvider />
<BenchHost Title="MudBlazor 9.11.0 / Material" Value0="@Value0" TimeValues="@TimeValues" TimeValue0="@TimeValue0" TimeChanges="@_timeChanges"
           TimeVariant="@_timeVariant" TimeVariantChanged="@(v => _timeVariant = v)" ResetTime="ResetTimes">
    <Date Context="i"><MudDatePicker Label="Date" Editable="true" Date="_dates[i]" DateChanged="@(v => SetDate(i, v))" /></Date>
    <Time Context="i"><MudTimePicker Editable="@TimeValues" AmPm="false" TimeFormat="@(TimeValues ? "HH:mm" : "")" MinuteSelectionStep="@(TimeValues ? 15 : 1)" Label="Time" Time="_times[i]" TimeChanged="@(v => SetTime(i, v))" /></Time>
</BenchHost>


@code {
    private bool TimeValues;
    protected override void OnInitialized() => TimeValues = Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("mode=time-values", StringComparison.Ordinal);
    private string _timeVariant = "Default";
    private int _timeChanges;
    private string? TimeValue0 => _times[0] is var v ? v?.ToString(@"hh\:mm\:ss", System.Globalization.CultureInfo.InvariantCulture) : null;
    private void SetTime(int i, TimeSpan? value) { _times[i] = value; if (TimeValues && i == 0) _timeChanges++; }
    private void ResetTimes() { Array.Clear(_times); _timeChanges = 0; }
    private readonly DateTime?[] _dates = new DateTime?[50];
    private readonly TimeSpan?[] _times = new TimeSpan?[50];

    private string? Value0 => _dates[0] is var v ? v?.ToString("yyyy-MM-dd") : null;

    private void SetDate(int i, DateTime? value) => _dates[i] = value;
}
