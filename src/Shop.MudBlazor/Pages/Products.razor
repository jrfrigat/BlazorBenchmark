@page "/products"
@inject ShopClient Api
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>Товары — MudBlazor</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" RowSpacing="2" Class="mb-4" Style="flex-wrap:wrap">
    <MudText Typo="Typo.h5">Товары</MudText>
    <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Поиск: название, артикул, категория…" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:320px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">Добавить товар</MudButton>
</MudStack>

<MudDataGrid T="Product" Items="@_products" QuickFilter="@_quickFilter" Hover="true" Elevation="1"
             RowsPerPage="15" SortMode="SortMode.Multiple" Filterable="false" HidePagination="@(_products is null || _products.Count <= 15)">
    <Columns>
        <PropertyColumn Property="p => p.Sku" Title="Артикул" />
        <PropertyColumn Property="p => p.Name" Title="Название" />
        <TemplateColumn T="Product" Title="Категория">
                <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@context.Item.Category</MudChip>
            </CellTemplate>
            </TemplateColumn>
        <PropertyColumn Property="p => p.Price" Title="Цена" Format="N0" />
        <TemplateColumn T="Product" Title="Остаток">
                <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Stock <= 5 ? Color.Error : Color.Success)">@context.Item.Stock</MudChip>
            </CellTemplate>
            </TemplateColumn>
        <TemplateColumn T="Product" Title="">
                <CellTemplate>
                <MudStack Row Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" aria-label="Изменить"
                                   OnClick="@(() => OpenEdit(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Удалить"
                                   OnClick="@(() => DeleteAsync(context.Item))" />
                </MudStack>
            </CellTemplate>
            </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Product" RowsPerPageString="Строк на странице:" />
    </PagerContent>
</MudDataGrid>

@code {
    private List<Product>? _products;
    private string _search = "";

    private Func<Product, bool> _quickFilter => p =>
        string.IsNullOrWhiteSpace(_search)
        || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || p.Category.Contains(_search, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _products = await Api.GetProductsAsync();
    }

    private async Task OpenCreate()
    {
        var dialog = await Dialog.ShowAsync<ProductDialog>("Новый товар",
            new DialogParameters { ["ProductId"] = null },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
            _products = await Api.GetProductsAsync();
    }

    private async Task OpenEdit(Product product)
    {
        var dialog = await Dialog.ShowAsync<ProductDialog>("Изменение товара",
            new DialogParameters { ["ProductId"] = product.Id },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
            _products = await Api.GetProductsAsync();
    }

    private async Task DeleteAsync(Product product)
    {
        var confirm = await Dialog.ShowAsync<ConfirmDialog>("Удаление товара", new DialogParameters { ["Message"] = $"Удалить «{product.Name}»?", ["YesText"] = "Удалить" }, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });
        if ((await confirm.Result).Canceled) return;
        try
        {
            await Api.DeleteProductAsync(product.Id);
            Snackbar.Add("Товар удалён", Severity.Info);
            _products = await Api.GetProductsAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Нет связи с сервером", Severity.Error);
        }
    }
}
