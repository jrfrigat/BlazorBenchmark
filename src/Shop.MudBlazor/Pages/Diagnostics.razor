@page "/diagnostics"
@inject DiagnosticsService Diag
@inject ISnackbar Snackbar

<PageTitle>Диагностика — MudBlazor</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Style="flex-wrap:wrap">
    <MudText Typo="Typo.h5">Диагностика</MudText>
    <MudStack Row Spacing="2">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                   Disabled="@(_report is null)" OnClick="CopyAsync">Скопировать отчёт</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="CollectAsync">Собрать метрики</MudButton>
    </MudStack>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    Метрики нагрузки приложения: тайминги загрузки и отрисовки, состав и вес ресурсов (рантайм .NET,
    пакет UI-библиотеки, шрифты), размер DOM и CSS, JS-куча, параметры устройства. Страница и скрипт
    идентичны во всех трёх приложениях бенчмарка — снимайте показатели после полной загрузки и обхода страниц.
</MudText>

@if (_report is null)
{
    <MudText Typo="Typo.body1">Нажмите «Собрать метрики»…</MudText>
}
else
{
    @foreach (var section in _report.ToSections())
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@section.Title</MudText>
            <MudSimpleTable Hover="true" Dense="true" Style="width:100%">
                <tbody>
                    @foreach (var row in section.Rows)
                    {
                        <tr>
                            <td style="width:320px">@row.Name</td>
                            <td>@row.Value</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Ресурсы по группам</MudText>
        <MudSimpleTable Hover="true" Dense="true" Style="width:100%">
            <thead>
                <tr>
                    <th style="width:320px">Группа</th>
                    <th>Файлов</th>
                    <th>По сети</th>
                    <th>Распаковано</th>
                    <th>Из кэша</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in _report.ResourceGroups)
                {
                    <tr>
                        <td>@group.Name</td>
                        <td>@group.Count</td>
                        <td>@DiagnosticsReport.Bytes(group.TransferBytes)</td>
                        <td>@DiagnosticsReport.Bytes(group.DecodedBytes)</td>
                        <td>@group.CachedCount</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private DiagnosticsReport? _report;

    private async Task CollectAsync() => _report = await Diag.CollectAsync("MudBlazor");

    private async Task CopyAsync()
    {
        if (_report is null) return;
        var copied = await Diag.CopyAsync(_report.ToPlainText());
        Snackbar.Add(copied ? "Отчёт скопирован" : "Браузер не дал доступ к буферу обмена",
            copied ? Severity.Success : Severity.Warning);
    }
}
