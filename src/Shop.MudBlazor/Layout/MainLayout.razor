@inherits LayoutComponentBase
@inject DiagnosticsService Diag

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Elevation="0">
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">Мини-Магазин</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">MudBlazor · Material</MudChip>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" Elevation="1">
        @* Ссылки БЕЗ ведущего слеша: с ним браузер считает их от корня сайта, и на GitHub Pages
           переход уводит на /diagnostics вместо /BlazorBenchmark/mudblazor/diagnostics. Относительные
           ссылки разрешаются от <base href> и работают и в корне, и в подкаталоге. *@
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Обзор</MudNavLink>
            <MudNavLink Href="products" Icon="@Icons.Material.Filled.Inventory2">Товары</MudNavLink>
            <MudNavLink Href="orders" Icon="@Icons.Material.Filled.ShoppingCart">Заказы</MudNavLink>
            <MudNavLink Href="payments" Icon="@Icons.Material.Filled.ReceiptLong">Оплаты</MudNavLink>
            <MudNavLink Href="customers" Icon="@Icons.Material.Filled.People">Клиенты</MudNavLink>
            <MudNavLink Href="components" Icon="@Icons.Material.Filled.Widgets">Компоненты</MudNavLink>
            <MudNavLink Href="diagnostics" Icon="@Icons.Material.Filled.Speed">Диагностика</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="px-6 pb-6">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    // Отмечаем момент, когда интерфейс приложения впервые готов: это главный показатель
    // сравнения библиотек на странице «Диагностика».
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Diag.MarkAppReadyAsync();
    }

    // Классическая палитра Material Design 2 (Indigo / Pink)
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3F51B5",
            Secondary = "#FF4081",
            AppbarBackground = "#3F51B5",
        },
    };
}
