@page "/diagnostics"
@inject DiagnosticsService Diag
@inject ISnackbarService Snackbar

<PageTitle>Диагностика — Flare</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium" Wrap="true">
        <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Диагностика</FlareText>
        <FlareSpacer />
        <FlareButton Variant="ButtonVariant.Text" OnClick="CopyAsync" Disabled="@(_report is null)">
            <LeadingIcon><FlareIconView Value="@FlareIcons.ContentCopy" /></LeadingIcon>
            <ChildContent>Скопировать отчёт</ChildContent>
        </FlareButton>
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="CollectAsync">
            <LeadingIcon><FlareIconView Value="@FlareIcons.Refresh" /></LeadingIcon>
            <ChildContent>Собрать метрики</ChildContent>
        </FlareButton>
    </FlareStack>

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
        Метрики нагрузки приложения: тайминги загрузки и отрисовки, состав и вес ресурсов (рантайм .NET,
        пакет UI-библиотеки, шрифты), размер DOM и CSS, JS-куча, параметры устройства. Страница и скрипт
        идентичны во всех трёх приложениях бенчмарка — снимайте показатели после полной загрузки и обхода страниц.
    </FlareText>

    @if (_report is null)
    {
        <FlareText Color="FlareColor.OnSurfaceVariant">Нажмите «Собрать метрики»…</FlareText>
    }
    else
    {
        @foreach (var section in _report.ToSections())
        {
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@section.Title" />
                <FlareCardContent>
                    <FlareDataGrid Items="@section.Rows" Height="auto" ShowPager="false" Dense="true">
                        <Columns>
                            <FlareColumn Title="Показатель" Field="@(r => r.Name)" Width="320px" />
                            <FlareColumn Title="Значение" Field="@(r => r.Value)" />
                        </Columns>
                    </FlareDataGrid>
                </FlareCardContent>
            </FlareCard>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="Ресурсы по группам" />
            <FlareCardContent>
                <FlareDataGrid Items="@_report.ResourceGroups" Height="auto" ShowPager="false" Dense="true">
                    <Columns>
                        <FlareColumn Title="Группа" Field="@(g => g.Name)" Width="320px" />
                        <FlareColumn Title="Файлов" Field="@(g => g.Count)" Width="100px" />
                        <FlareColumn Title="По сети">
                            <Template Context="g">@DiagnosticsReport.Bytes(g.TransferBytes)</Template>
                        </FlareColumn>
                        <FlareColumn Title="Распаковано">
                            <Template Context="g">@DiagnosticsReport.Bytes(g.DecodedBytes)</Template>
                        </FlareColumn>
                        <FlareColumn Title="Из кэша" Field="@(g => g.CachedCount)" Width="100px" />
                    </Columns>
                </FlareDataGrid>
            </FlareCardContent>
        </FlareCard>
    }
</FlareStack>

@code {
    private DiagnosticsReport? _report;

    private async Task CollectAsync() => _report = await Diag.CollectAsync("Flare");

    private async Task CopyAsync()
    {
        if (_report is null) return;
        var copied = await Diag.CopyAsync(_report.ToPlainText());
        Snackbar.Show(copied ? "Отчёт скопирован" : "Браузер не дал доступ к буферу обмена",
            copied ? SnackbarSeverity.Success : SnackbarSeverity.Warning);
    }
}
