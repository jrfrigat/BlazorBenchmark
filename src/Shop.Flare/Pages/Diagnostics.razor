@page "/diagnostics"
@inject DiagnosticsService Diag

<PageTitle>Диагностика — Flare</PageTitle>

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium" Wrap="true">
        <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">Диагностика</FlareText>
        <FlareSpacer />
        <FlareButton Variant="ButtonVariant.Outlined" OnClick="CollectAsync">
            <LeadingIcon><FlareIconView Value="@FlareIcons.Refresh" /></LeadingIcon>
            <ChildContent>Собрать метрики</ChildContent>
        </FlareButton>
    </FlareStack>

    <FlareText Color="FlareColor.OnSurfaceVariant" Typo="TypographyScale.BodyMedium">
        Метрики нагрузки приложения: тайминги загрузки страницы, объём загруженных ресурсов, размер DOM и JS-кучи.
        Страница идентична во всех трёх приложениях бенчмарка — снимайте показатели после полной загрузки и обхода страниц.
    </FlareText>

    @if (_report is null)
    {
        <FlareText Color="FlareColor.OnSurfaceVariant">Нажмите «Собрать метрики»…</FlareText>
    }
    else
    {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardContent>
                <FlareDataGrid Items="@Rows" Height="auto" ShowPager="false" Dense="true">
                    <Columns>
                        <FlareColumn Title="Показатель" Field="@(r => r.Name)" Width="300px" />
                        <FlareColumn Title="Значение" Field="@(r => r.Value)" />
                    </Columns>
                </FlareDataGrid>
            </FlareCardContent>
        </FlareCard>
    }
</FlareStack>

@code {
    private DiagnosticsReport? _report;

    private readonly record struct MetricRow(string Name, string Value);

    private IEnumerable<MetricRow> Rows => _report is null ? [] :
    [
        new("DOM interactive, мс", _report.DomInteractiveMs?.ToString() ?? "—"),
        new("DOMContentLoaded, мс", _report.DomContentLoadedMs?.ToString() ?? "—"),
        new("Load event, мс", _report.LoadEventMs?.ToString() ?? "—"),
        new("Ресурсов загружено", _report.ResourceCount.ToString()),
        new("Объём ресурсов (transfer)", DiagnosticsReport.Bytes(_report.ResourceTransferBytes)),
        new("Узлов в DOM", _report.DomNodes.ToString()),
        new("JS-куча (used)", _report.UsedJsHeapBytes is { } used ? DiagnosticsReport.Bytes(used) : "нет данных"),
        new("JS-куча (total)", _report.TotalJsHeapBytes is { } total ? DiagnosticsReport.Bytes(total) : "нет данных"),
        new("Device pixel ratio", _report.DevicePixelRatio.ToString("0.##")),
        new("User agent", _report.UserAgent),
    ];

    private async Task CollectAsync()
    {
        _report = await Diag.CollectAsync();
    }
}
