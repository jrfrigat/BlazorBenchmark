<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ThemeSet Condition="'$(ThemeSet)' == ''">Md2</ThemeSet>
    <DefineConstants Condition="'$(ThemeSet)' == 'Fluent2'">$(DefineConstants);FLUENT_THEME</DefineConstants>
    <DefineConstants Condition="'$(ThemeSet)' == 'All'">$(DefineConstants);ALL_THEMES</DefineConstants>
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flare.Blazor" Version="0.45.0" />
    <PackageReference Condition="'$(ThemeSet)' != 'Fluent2'" Include="Flare.Theme.MaterialDesign2" Version="0.45.0" />
    <PackageReference Include="Flare.Icons.MaterialDesign2.Svg" Version="0.45.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bench.Shared\Bench.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ThemeSet)' == 'Fluent2' Or '$(ThemeSet)' == 'All'">
    <PackageReference Include="Flare.Theme.FluentUI2" Version="0.45.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ThemeSet)' == 'All'">
    <PackageReference Include="Flare.Theme.MaterialDesign3" Version="0.45.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.45.0" />
    <PackageReference Include="Flare.Theme.Aero" Version="0.45.0" />
    <PackageReference Include="Flare.Theme.LiquidGlass" Version="0.45.0" />
    <PackageReference Include="Flare.Theme.VisualStudio" Version="0.45.0" />
  </ItemGroup>
</Project>
