@namespace Bench.Flare
@inject global::Flare.Abstractions.IThemeService Themes
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<FlareThemeProvider Stylesheets="ThemeStylesheets.Manual">
@if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("switch=1", StringComparison.Ordinal))
{
<div id="bench-themes" data-bench-active-theme="@_completedTheme">
@foreach (var theme in Themes.Themes)
{
    <button type="button" data-bench-theme="@theme.Id" @onclick="() => SwitchTheme(theme.Id)">@theme.DisplayName</button>
}
</div>
}
@if (RangeMode)
{
    <RangeBenchHost Title="@ThemeSetup.Title" StartValue="@RangeStart" EndValue="@RangeEnd" RangeChanges="@_rangeChanges">
        <Fields Context="i">
            <FlareDateRangePicker Mode="DateRangePickerMode.Fields" Min="RangeMin" Max="RangeMax" StartDate="_rangeStarts[i]"
                                  StartDateChanged="@(v => SetRangeStart(i, v))" EndDate="_rangeEnds[i]"
                                  EndDateChanged="@(v => SetRangeEnd(i, v))" StartLabel="Start" EndLabel="End" />
        </Fields>
        <Calendar Context="i">
            <FlareDateRangePicker Mode="DateRangePickerMode.Calendar" Min="RangeMin" Max="RangeMax" StartDate="_rangeStarts[i]"
                                  StartDateChanged="@(v => SetRangeStart(i, v))" EndDate="_rangeEnds[i]"
                                  EndDateChanged="@(v => SetRangeEnd(i, v))" Label="Range" />
        </Calendar>
    </RangeBenchHost>
}
else if (ComponentsMode)
{
    <ComponentBenchHost Title="@ThemeSetup.Title" Context="state"><ComponentSamples State="@state" /></ComponentBenchHost>
}
else
{
<BenchHost Title="@ThemeSetup.Title" Value0="@Value0" TimeValues="@TimeValues" TimeValue0="@TimeValue0" TimeChanges="@_timeChanges"
           TimeVariant="@_timeVariant" TimeVariantChanged="SetPopupVariant" ResetTime="ResetTimes">
    <Date Context="i"><FlareDatePicker PreRenderCalendar="@PreRenderCalendar" Label="Date" Value="_dates[i]" ValueChanged="@(v => SetDate(i, v))" /></Date>
    <Time Context="i"><FlareTimePicker PopupVariant="@_popupVariant" Use24Hour="@(TimeValues ? true : null)" MinuteStep="@(TimeValues ? 15 : 1)" Min="@(TimeValues ? new TimeOnly(8, 0) : null)" Max="@(TimeValues ? new TimeOnly(18, 0) : null)" Label="Time" Value="_times[i]" ValueChanged="@(v => SetTime(i, v))" /></Time>
</BenchHost>
}
</FlareThemeProvider>

@code {
    private bool PreRenderCalendar;
    private bool ComponentsMode => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Split('?', '&').Contains("mode=components", StringComparer.Ordinal);
    private bool RangeMode => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Split('?', '&').Contains("mode=range", StringComparer.Ordinal);
    private bool TimeValues;

    private static readonly DateOnly RangeMin = new(2026, 10, 1);
    private static readonly DateOnly RangeMax = new(2026, 12, 31);
    private readonly DateOnly?[] _rangeStarts = new DateOnly?[50];
    private readonly DateOnly?[] _rangeEnds = new DateOnly?[50];
    private int _rangeChanges;
    private string? RangeStart => _rangeStarts[0]?.ToString("yyyy-MM-dd");
    private string? RangeEnd => _rangeEnds[0]?.ToString("yyyy-MM-dd");
    private void SetRangeStart(int i, DateOnly? value) { _rangeStarts[i] = value; if (i == 0) _rangeChanges++; }
    private void SetRangeEnd(int i, DateOnly? value) { _rangeEnds[i] = value; if (i == 0) _rangeChanges++; }

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        TimeValues = query.Contains("mode=time-values", StringComparison.Ordinal);
        PreRenderCalendar = query.Split('?', '&').Contains("prerenderCalendar=1", StringComparer.Ordinal);
        for (var i = 0; i < 50; i++)
        {
            _rangeStarts[i] = new DateOnly(2026, 10, 14);
            _rangeEnds[i] = new DateOnly(2026, 10, 20);
        }
    }
    private string _timeVariant = "Dial";
    private int _timeChanges;
    private string? TimeValue0 => _times[0] is var v ? v?.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) : null;
    private void SetTime(int i, TimeOnly? value) { _times[i] = value; if (TimeValues && i == 0) _timeChanges++; }
    private void ResetTimes() { Array.Clear(_times); _timeChanges = 0; }
    private TimePickerVariant _popupVariant = TimePickerVariant.Dial;
    private void SetPopupVariant(string value) { _timeVariant = value; _popupVariant = Enum.Parse<TimePickerVariant>(value); }
    private string _completedTheme = "";
    private async Task SwitchTheme(string id)
    {
        await Themes.SetThemeAsync(id);
        await Themes.SetPaletteAsync(Themes.CurrentTheme.DefaultPaletteId);
        _completedTheme = id;
    }

    private readonly DateOnly?[] _dates = new DateOnly?[50];
    private readonly TimeOnly?[] _times = new TimeOnly?[50];

    private string? Value0 => _dates[0] is var v ? v?.ToString("yyyy-MM-dd") : null;

    private void SetDate(int i, DateOnly? value) => _dates[i] = value;
}
