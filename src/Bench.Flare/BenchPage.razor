@namespace Bench.Flare

<FlareThemeProvider Stylesheets="ThemeStylesheets.Manual">
<BenchHost Title="Flare (this branch) / Material Design 2" Value0="@Value0">
    <Date Context="i"><FlareDatePicker Label="Date" Value="_dates[i]" ValueChanged="@(v => SetDate(i, v))" /></Date>
    <Time Context="i"><FlareTimePicker Label="Time" Value="_times[i]" ValueChanged="@(v => _times[i] = v)" /></Time>
</BenchHost>
</FlareThemeProvider>

@code {
    private readonly DateOnly?[] _dates = new DateOnly?[50];
    private readonly TimeOnly?[] _times = new TimeOnly?[50];

    private string? Value0 => _dates[0] is var v ? v?.ToString("yyyy-MM-dd") : null;

    private void SetDate(int i, DateOnly? value) => _dates[i] = value;
}
