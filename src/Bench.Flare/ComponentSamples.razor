@namespace Bench.Flare
@if (State.Kind == "datagrid")
{
    <FlareDataGrid Items="@State.Rows" Height="auto" ShowPager="false" PageSize="1000">
        <Columns>
            <FlareColumn Title="Id"><Template Context="row">@BenchGridCells.Cell(row, "id")</Template></FlareColumn>
            <FlareColumn Title="Name"><Template Context="row">@BenchGridCells.Cell(row, "name")</Template></FlareColumn>
            <FlareColumn Title="Price"><Template Context="row">@BenchGridCells.Cell(row, "price")</Template></FlareColumn>
            <FlareColumn Title="Stock"><Template Context="row">@BenchGridCells.Cell(row, "stock")</Template></FlareColumn>
            <FlareColumn Title="Active"><Template Context="row">@BenchGridCells.Cell(row, "active")</Template></FlareColumn>
        </Columns>
    </FlareDataGrid>
}
else
{
    @for (var i = 0; i < State.Count; i++)
    {
        var index = i;
        <div class="component-sample" data-index="@index" @key="index">
            @switch (State.Kind)
            {
                case "button": <FlareButton OnClick="() => State.Click(index)">Action @index</FlareButton> break;
                case "text": <FlareTextField Label="@($"Text {index}")" Value="@State.Text[index]" ValueChanged="v => State.SetText(index, v)" /> break;
                case "number": <FlareNumericField TValue="decimal" Label="@($"Number {index}")" Value="@State.Numbers[index]" ValueChanged="v => State.SetNumber(index, v)" Min="0" Max="1000" Step="0.25" /> break;
                case "checkbox": <FlareCheckbox TValue="bool" Label="@($"Check {index}")" Value="@State.Checks[index]" ValueChanged="v => State.SetCheck(index, v)" /> break;
                case "switch": <FlareSwitch Label="@($"Switch {index}")" Value="@State.Switches[index]" ValueChanged="v => State.SetSwitch(index, v)" /> break;
                case "select": <FlareSelect TValue="string" Label="@($"Select {index}")" Items="@ComponentBenchState.Options" Value="@State.Selections[index]" ValueChanged="v => State.SetSelection(index, v)" /> break;
            }
        </div>
    }
}
@code { [Parameter, EditorRequired] public ComponentBenchState State { get; set; } = default!; }
