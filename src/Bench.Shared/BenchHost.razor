@namespace Bench.Shared
@inject IJSRuntime JS

@* Одинаковый каркас замера для всех пяти библиотек: кнопка монтирования, N полей даты и N полей
   времени из шаблонов приложения, и строка со значением первого поля для сценария ввода. Отличается
   только то, какой компонент библиотека кладет в шаблон. *@
<main class="bench">
    <h1>@Title</h1>
    <button id="bench-mount" type="button" @onclick="Mount">Mount @Count</button>
    <button id="bench-single-date" type="button" @onclick='() => Shape("date")'>One date</button>
    <button id="bench-single-time" type="button" @onclick='() => Shape("time")'>One time</button>
    <button id="bench-many" type="button" @onclick='() => Shape("mixed")'>50 date + 50 time</button>
    <button id="bench-rerender" type="button" @onclick="() => _renderVersion++">Rerender container</button>
    <span id="bench-shape">@_shape</span><span id="bench-render-version">@_renderVersion</span>
    <button id="bench-unmount" type="button" @onclick="Unmount">Unmount</button>
    <button id="bench-analytics" type="button" @onclick="RunAnalytics">Measure startup on reload</button>
    <button id="bench-interactions" type="button" @onclick="RunInteractions">Measure picker interactions</button>
    <button type="button" @onclick="Download">Download JSON</button>
    <span id="bench-value">@Value0</span>
    @if (TimeValues)
    {
        <span id="bench-time-value" data-changes="@TimeChanges">@TimeValue0</span>
        <span id="bench-time-variant">@TimeVariant</span>
        <button id="bench-many-time" type="button" @onclick='() => Shape("times")'>50 time</button>
        <button id="bench-time-reset" type="button" @onclick="ResetTime">Reset time values</button>
        @foreach (var variant in (TimeVariant == "Default" ? Array.Empty<string>() : new[] { "Dial", "Dropdown", "List" }))
        {
            var selected = variant;
            <button id="@($"bench-time-{variant}")" type="button" @onclick="() => TimeVariantChanged.InvokeAsync(selected)">@variant</button>
        }
        <button id="bench-time-values" type="button" @onclick="RunTimeValues">Measure time values</button>
    }
    @if (_mounted)
    {
        <section class="bench-dates">
            @for (var i = 0; i < DateCount; i++)
            {
                var index = i;
                <div class="bench-date" @key="index">@Date(index)</div>
            }
        </section>
        <section class="bench-times">
            @for (var i = 0; i < TimeCount; i++)
            {
                var index = i;
                <div class="bench-time" @key="index">@Time(index)</div>
            }
        </section>
        <span id="bench-mounted" data-dates="@DateCount" data-times="@TimeCount"></span>
    }
    <pre id="bench-report"></pre>
</main>

@code {
    /// <summary>Библиотека и тема, что замеряются.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>Поле даты номер i.</summary>
    [Parameter, EditorRequired] public RenderFragment<int> Date { get; set; } = default!;
    /// <summary>Поле времени номер i.</summary>
    [Parameter, EditorRequired] public RenderFragment<int> Time { get; set; } = default!;
    /// <summary>Значение первого поля даты в виде yyyy-MM-dd - по нему сценарий ввода видит, что дата принята.</summary>
    [Parameter] public string? Value0 { get; set; }
    /// <summary>Сколько полей каждого вида монтируется.</summary>
    [Parameter] public int Count { get; set; } = 50;

    /// <summary>Enables the separate time-value protocol.</summary>
    [Parameter] public bool TimeValues { get; set; }
    /// <summary>First bound time, formatted as HH:mm:ss.</summary>
    [Parameter] public string? TimeValue0 { get; set; }
    /// <summary>Number of first-time value callbacks.</summary>
    [Parameter] public int TimeChanges { get; set; }
    /// <summary>Current time popup model.</summary>
    [Parameter] public string TimeVariant { get; set; } = "Default";
    /// <summary>Changes the time popup model.</summary>
    [Parameter] public EventCallback<string> TimeVariantChanged { get; set; }
    /// <summary>Clears bound times and the callback count.</summary>
    [Parameter] public EventCallback ResetTime { get; set; }
    private Task RunTimeValues() => JS.InvokeVoidAsync("benchTimeValues.run").AsTask();
    private bool _mounted;
    private string _shape = "mixed";
    private int _renderVersion;
    private int DateCount => _shape is "time" or "times" ? 0 : _shape == "date" ? 1 : Count;
    private int TimeCount => _shape == "date" ? 0 : _shape == "time" ? 1 : Count;
    private void Shape(string shape) { _mounted = false; _shape = shape; }

    private void Mount() => _mounted = true;
    private void Unmount() => _mounted = false;
    private Task RunAnalytics() => JS.InvokeVoidAsync("benchAnalytics.restart").AsTask();
    private Task RunInteractions() => JS.InvokeVoidAsync("bench.run").AsTask();
    private Task Download() => JS.InvokeVoidAsync("benchAnalytics.download").AsTask();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("shopDiagnostics.markAppReady");
    }
}
