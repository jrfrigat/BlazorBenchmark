@namespace Bench.Radzen


<BenchHost Title="Radzen.Blazor 12.0.5 / Material" Value0="@Value0">
    <Date Context="i"><RadzenDatePicker TValue="DateTime?" Placeholder="Date" DateFormat="MM/dd/yyyy" Value="_dates[i]" ValueChanged="@(v => SetDate(i, v))" /></Date>
    <Time Context="i"><RadzenDatePicker TValue="DateTime?" Placeholder="Time" TimeOnly="true" ShowTime="true" DateFormat="HH:mm" Value="_times[i]" ValueChanged="@(v => _times[i] = v)" /></Time>
</BenchHost>


@code {
    private readonly DateTime?[] _dates = new DateTime?[50];
    private readonly DateTime?[] _times = new DateTime?[50];

    private string? Value0 => _dates[0] is var v ? v?.ToString("yyyy-MM-dd") : null;

    private void SetDate(int i, DateTime? value) => _dates[i] = value;
}
