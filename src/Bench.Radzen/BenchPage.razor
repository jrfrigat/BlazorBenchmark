@namespace Bench.Radzen
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation


@if (RangeMode)
{
    <RangeBenchHost Title="Radzen.Blazor 12.1.4 / Material" StartValue="@RangeStart" EndValue="@RangeEnd" RangeChanges="@_rangeChanges">
        <Fields Context="i">
            <div class="bench-field bench-field-start">
                <RadzenFormField Text="Start"><RadzenDatePicker TValue="DateTime?" DateFormat="MM/dd/yyyy" Min="RangeMin" Max="RangeMax" Value="_rangeStarts[i]" ValueChanged="@(v => SetRangeStart(i, v))" /></RadzenFormField>
            </div>
            <div class="bench-field bench-field-end">
                <RadzenFormField Text="End"><RadzenDatePicker TValue="DateTime?" DateFormat="MM/dd/yyyy" Min="RangeMin" Max="RangeMax" Value="_rangeEnds[i]" ValueChanged="@(v => SetRangeEnd(i, v))" /></RadzenFormField>
            </div>
        </Fields>
        <Calendar Context="i">
            <RadzenDateRangePicker Value="_ranges[i]" ValueChanged="@(v => SetRange(i, v))" Inline="true" DisplayMonths="1" Min="RangeMin" Max="RangeMax" />
        </Calendar>
        <Popup Context="i">
            <RadzenDateRangePicker Value="_ranges[i]" ValueChanged="@(v => SetRange(i, v))" Min="RangeMin" Max="RangeMax" />
        </Popup>
    </RangeBenchHost>
}
else if (ComponentsMode)
{
    <ComponentBenchHost Title="Radzen.Blazor 12.1.4 / Material" Context="state"><ComponentSamples State="@state" /></ComponentBenchHost>
}
else
{
<BenchHost Title="Radzen.Blazor 12.1.4 / Material" Value0="@Value0" TimeValues="@TimeValues" TimeValue0="@TimeValue0" TimeChanges="@_timeChanges"
           TimeVariant="@_timeVariant" TimeVariantChanged="@(v => _timeVariant = v)" ResetTime="ResetTimes">
    <Date Context="i"><RadzenFormField Text="Date"><RadzenDatePicker TValue="DateTime?" DateFormat="MM/dd/yyyy" Value="_dates[i]" ValueChanged="@(v => SetDate(i, v))" /></RadzenFormField></Date>
    <Time Context="i"><RadzenFormField Text="Time"><RadzenDatePicker TValue="DateTime?" TimeOnly="true" ShowTime="true" MinutesStep="@(TimeValues ? "15" : "")" DateFormat="HH:mm" Value="_times[i]" ValueChanged="@(v => SetTime(i, v))" /></RadzenFormField></Time>
</BenchHost>
}


@code {
    private bool ComponentsMode => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Split('?', '&').Contains("mode=components", StringComparer.Ordinal);
    private bool RangeMode => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Split('?', '&').Contains("mode=range", StringComparer.Ordinal);
    private bool TimeValues;

    private static readonly DateTime RangeMin = new(2026, 10, 1);
    private static readonly DateTime RangeMax = new(2026, 12, 31);
    private readonly DateTime?[] _rangeStarts = new DateTime?[50];
    private readonly DateTime?[] _rangeEnds = new DateTime?[50];
    private readonly global::Radzen.DateRange[] _ranges = new global::Radzen.DateRange[50];
    private int _rangeChanges;
    private string? RangeStart => _rangeStarts[0]?.ToString("yyyy-MM-dd");
    private string? RangeEnd => _rangeEnds[0]?.ToString("yyyy-MM-dd");
    private void SetRangeStart(int i, DateTime? value) { _rangeStarts[i] = value; if (i == 0) _rangeChanges++; }
    private void SetRangeEnd(int i, DateTime? value) { _rangeEnds[i] = value; if (i == 0) _rangeChanges++; }
    private void SetRange(int i, global::Radzen.DateRange value)
    {
        _ranges[i] = value;
        if (i != 0) return;
        _rangeStarts[0] = value.Start;
        _rangeEnds[0] = value.End;
        _rangeChanges++;
    }

    protected override void OnInitialized()
    {
        TimeValues = Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("mode=time-values", StringComparison.Ordinal);
        for (var i = 0; i < 50; i++)
        {
            _rangeStarts[i] = new DateTime(2026, 10, 14);
            _rangeEnds[i] = new DateTime(2026, 10, 20);
            _ranges[i] = new global::Radzen.DateRange(_rangeStarts[i], _rangeEnds[i]);
        }
    }
    private string _timeVariant = "Default";
    private int _timeChanges;
    private string? TimeValue0 => _times[0] is var v ? v?.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) : null;
    private void SetTime(int i, DateTime? value) { _times[i] = value; if (TimeValues && i == 0) _timeChanges++; }
    private void ResetTimes() { Array.Clear(_times); _timeChanges = 0; }
    private readonly DateTime?[] _dates = new DateTime?[50];
    private readonly DateTime?[] _times = new DateTime?[50];

    private string? Value0 => _dates[0] is var v ? v?.ToString("yyyy-MM-dd") : null;

    private void SetDate(int i, DateTime? value) => _dates[i] = value;
}
